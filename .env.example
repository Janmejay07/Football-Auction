# MongoDB Atlas
# Cluster → Connect → Drivers → paste the SRV URI, then add your DB name.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=football-auction

# Public site URL for invite links (Vercel, ngrok, Cloudflare Tunnel, etc.)
# NEXT_PUBLIC_APP_URL=https://your-app.example.com

# Optional TURN servers so camera/mic work across home NATs.
# Without these, free public TURN relays are used automatically.
# Better reliability: https://www.metered.ca/tools/openrelay/ or https://www.expressturn.com/
# TURN_URLS=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:443
# TURN_USERNAME=
# TURN_CREDENTIAL=
